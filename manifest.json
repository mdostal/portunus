{
  "name": "portunus",
  "type": "core",
  "version": "0.5.1",
  "description": "Secret broker for the Dostal harness — reference registry + boundary-only resolver so a plaintext secret never enters an LLM/agent context.",
  "author": "Mathew Dostal",
  "license": "MIT",
  "engine": {
    "kind": "tool",
    "entry": "portunus",
    "install": "pipx install portunus"
  },
  "ui": {
    "url": "http://localhost:7802",
    "tab": "Vault",
    "mount": "link",
    "health_endpoint": "http://localhost:7802/api/health"
  },
  "capabilities": ["secret-lookup", "secret-injection", "secret-vault", "session-vault"],
  "requires": [],
  "config": {
    "home": "${PORTUNUS_HOME:-~/.portunus}",
    "gcp_project": "${PORTUNUS_GCP_PROJECT:-}",
    "backend": "local"
  }
}
