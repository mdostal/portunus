{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portunus",
  "version": "0.24.0",
  "identifier": "com.mdostal.portunus",
  "build": {
    "frontendDist": "./dist-placeholder",
    "beforeBuildCommand": "npm run build && bash src-tauri/build-resources.sh"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/web": "web",
      "resources/relauncher.sh": "relauncher.sh"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
