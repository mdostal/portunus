#!/usr/bin/env python3
"""bin/secrets — the local-first secret broker CLI (Portunus local encrypted tier).

Runs straight from a clone (no install needed): values encrypted at rest under
a Keychain-held master key; injection only via 0600 env file, child-process
env (exec), or {{secret:NAME}} boundary resolution. See src/portunus/secrets_cli.py.
"""
import os
import sys

_here = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
_src = os.path.join(os.path.dirname(_here), "src")
if os.path.isdir(os.path.join(_src, "portunus")) and _src not in sys.path:
    sys.path.insert(0, _src)

from portunus.secrets_cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
