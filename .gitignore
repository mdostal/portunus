# secrets & real config — NEVER commit
.env
.env.*
*.local
*.key
*-sa.json
**/auth.json
*.secret.*

# portunus runtime state (registry, audit log, approvals, clock)
.portunus/
registry.json
audit.log

# Hive session-runtime state (harness-generated, not source). `**/` so this
# also catches stray nested copies (e.g. ui/.pHive/, ui/src-tauri/.pHive/)
# created when a tool runs with a subdirectory as cwd -- the bare `.pHive/...`
# form (no `**/`) only anchors at the repo root and previously missed those.
**/.pHive/agent-complete/
**/.pHive/interrupts/
**/.pHive/metrics/
**/.pHive/session-effort.txt

# python build / runtime
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.coverage

# os
.DS_Store
.venv/
.playwright-mcp/
